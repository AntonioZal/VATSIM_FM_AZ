import math

# Fonction qui retourne une coordonnées GPS Nord ou Sud
def sexagesimal_nord_sud(point_latitude):

    direction_cardinale = ("N", "S")

    direction = direction_cardinale[0] if point_latitude >= 0 else direction_cardinale[1]
    point_latitude = abs(point_latitude)
    degres = int(point_latitude)
    minutes_flottantes = (point_latitude - degres) * 60
    minutes = int(minutes_flottantes)
    secondes = round((minutes_flottantes - minutes) * 60)

    return f"{degres:03d}° {minutes:02d}'{secondes:02d} {direction}"

# Fonction qui retourne une coordonnées GPS Est ou West
def sexagesimal_est_west(point_latitude):

    direction_cardinale = ("E", "W")

    direction = direction_cardinale[0] if point_latitude >= 0 else direction_cardinale[1]
    point_latitude = abs(point_latitude)
    degres = int(point_latitude)
    minutes_flottantes = (point_latitude - degres) * 60
    minutes = int(minutes_flottantes)
    secondes = round((minutes_flottantes - minutes) * 60)

    return f"{degres:03d}° {minutes:02d}'{secondes:02d} {direction}"

# Fonction qui permet de calculer une distance en mètres entre deux points GPS
def metres_position_gps(lat_1_ns, lon_1_ew, lat_2_ns, lon_2_ew):
    # Rayon de la Terre en mètres
    rayon_terre_metres = 6384415
    # Convertion des latitudes en radian
    lat_1_ns_radian = math.radians(lat_1_ns)
    lat_2_ns_radian = math.radians(lat_2_ns)

    # Convertion des longitudes en radian
    lon_1_ew_radian = math.radians(lon_1_ew)
    lon_2_ew_radian = math.radians(lon_2_ew)

    # Différence en radian des deux latitudes
    difference_lat_radian = lat_2_ns_radian - lat_1_ns_radian

    # Différence de longitudes entre deux points GPS
    difference_lon_radian = lon_1_ew_radian - lon_2_ew_radian

    # Mesure de la distance angulaire entre deux points GPS
    mesure_distance_angulaire = math.sin(difference_lat_radian / 2) ** 2 + math.cos(lat_1_ns_radian) * math.cos(lat_2_ns_radian) * math.sin(difference_lon_radian / 2) ** 2

    # Convertion distance angulaire en distance réelle
    conversion_angulaire_reelle = 2 * math.atan2(math.sqrt(mesure_distance_angulaire), math.sqrt(1 - mesure_distance_angulaire))

    # Distance en mètres
    distance_metres = rayon_terre_metres * conversion_angulaire_reelle

    return distance_metres